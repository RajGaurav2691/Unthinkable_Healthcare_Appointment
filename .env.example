# Database Configuration
POSTGRES_DB=healthcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Security (For future phases)
JWT_SECRET=your_super_secret_jwt_key_that_should_be_very_long

# External Integrations
# LLM_PROVIDER can be 'mock' or 'gemini'
LLM_PROVIDER=mock
LLM_API_KEY=your_gemini_api_key_here
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-1.5-flash

# Email Configuration
EMAIL_ENABLED=false
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@example.com

# Google Calendar OAuth 2.0 Configuration
# Set GOOGLE_CALENDAR_ENABLED=true to enable real Google Calendar integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Redirect URI must be registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8083/api/calendar/callback
